FROM apache/airflow:2.10.2-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

USER airflow
WORKDIR /opt/airflow

COPY --chown=airflow:root pyproject.toml /opt/airflow/pyproject.toml
COPY --chown=airflow:root src /opt/airflow/src

# CPU wheels only — avoids pulling CUDA/cuDNN/Triton from PyPI when ML deps install.
RUN pip install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -e /opt/airflow

# Commit the image was built from — surfaced in pipeline_runs.git_sha for traceability (§3.2).
# Placed last so changing the SHA does not invalidate the expensive dependency layers above.
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
