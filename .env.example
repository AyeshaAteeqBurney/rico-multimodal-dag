POSTGRES_DB=rico
POSTGRES_USER=rico
POSTGRES_PASSWORD=rico
# Host machine / IDE: use localhost. Docker Compose overrides POSTGRES_HOST etc. for Airflow containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rico-raw

OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
PROMPT_VERSION=v1
CLIP_VERSION=ViT-B-32/laion2b_s34b_b79k
SBERT_VERSION=all-MiniLM-L6-v2

CHOSEN_SCREENS_FILE=/opt/airflow/data/chosen_screens.txt

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Required identical on webserver + scheduler (docker-compose sets a dev default if unset).
# Override in production. Used for session signing and remote task log viewing (403 if mismatched).
AIRFLOW_WEBSERVER_SECRET_KEY=rico-p4-local-airflow-webserver-secret-do-not-use-in-prod

# Optional; set in local .env only — never commit a real webhook URL.
SLACK_WEBHOOK_URL=

# Optional: DNS servers for Airflow containers (docker-compose `x-airflow-dns`). Helps when
# `ingest_task` cannot resolve huggingface.co or Slack webhooks fail with NameResolutionError.
# COMPOSE_DNS_SERVER_1=8.8.8.8
# COMPOSE_DNS_SERVER_2=8.8.4.4

