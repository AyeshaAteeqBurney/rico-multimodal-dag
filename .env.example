POSTGRES_DB=rico
POSTGRES_USER=rico
POSTGRES_PASSWORD=rico
# Host machine / IDE: use localhost. Docker Compose overrides POSTGRES_HOST etc. for Airflow containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rico-raw

OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
PROMPT_VERSION=v1
CLIP_VERSION=ViT-B-32/laion2b_s34b_b79k
SBERT_VERSION=all-MiniLM-L6-v2

CHOSEN_SCREENS_FILE=/opt/airflow/data/chosen_screens.txt

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Required identical on webserver + scheduler (docker-compose sets a dev default if unset).
# Override in production. Used for session signing and remote task log viewing (403 if mismatched).
AIRFLOW_WEBSERVER_SECRET_KEY=rico-p4-local-airflow-webserver-secret-do-not-use-in-prod

# Optional: commit SHA stored on pipeline_runs (Airflow containers have no .git unless set).
# GIT_SHA=

# Optional; set in local .env only — never commit a real webhook URL.
SLACK_WEBHOOK_URL=

# Optional: DNS servers for Airflow containers (docker-compose `x-airflow-dns`). Helps when
# `ingest_task` cannot resolve huggingface.co or Slack webhooks fail with NameResolutionError.
# COMPOSE_DNS_SERVER_1=8.8.8.8
# COMPOSE_DNS_SERVER_2=8.8.4.4

# ── Bonus: Backfill Agent (agent/agent.py) ───────────────────────────────────
# Required for `make agent`. Never commit real tokens.
# Bot User OAuth Token from Slack App → OAuth & Permissions.
SLACK_BOT_TOKEN=
# App-Level Token from Slack App → Socket Mode (scope: connections:write).
SLACK_APP_TOKEN=
# Airflow REST API — host-side URL (agent runs on host, not in Docker).
AIRFLOW_API_URL=http://localhost:8080
# Credentials for Airflow basic auth (defaults to AIRFLOW_ADMIN_USER/PASSWORD above).
# AIRFLOW_API_USER=admin
# AIRFLOW_API_PASSWORD=admin
# DAG to trigger (override if you rename it).
# AIRFLOW_DAG_ID=rico_pipeline
# Override Ollama endpoint for the agent if it differs from the pipeline default.
# AGENT_OLLAMA_ENDPOINT=http://localhost:11434
# Timeout in seconds for the LLM call inside the agent.
# AGENT_LLM_TIMEOUT=60

